---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Consulta tu Recomendación"
  description="Consulta el estado de tu recomendación CEDH o CNDH en tiempo real. Ingresa tu número de expediente y conoce el avance."
>

  <!-- HERO -->
  <section class="semaforo-hero" aria-label="Consulta de recomendación">
    <div class="container">
      <span class="badge badge-rosa">Seguimiento ciudadano</span>
      <h1 class="semaforo-title">Consulta el estado de tu recomendación</h1>
      <p class="semaforo-desc">
        Ingresa el número de tu expediente CEDH o CNDH para ver en tiempo real
        cómo avanza el cumplimiento de tu recomendación.
      </p>
    </div>
  </section>

  <!-- BUSCADOR -->
  <section class="section" aria-label="Búsqueda de expediente">
    <div class="container">
      <div class="search-box">
        <div class="search-header">
          <h2>Buscar expediente</h2>
          <p>El número de expediente aparece en la notificación o documento oficial que recibiste.</p>
        </div>

        <div class="search-form" role="search">
          <div class="search-row">
            <label for="tipo-rec" class="form-label">Tipo de recomendación</label>
            <select id="tipo-rec" class="form-select">
              <option value="">Selecciona...</option>
              <option value="cedh">CEDH — Comisión Estatal de Derechos Humanos</option>
              <option value="cndh">CNDH — Comisión Nacional de Derechos Humanos</option>
            </select>
          </div>

          <div class="search-row">
            <label for="num-exp" class="form-label">Número de expediente</label>
            <input
              type="text"
              id="num-exp"
              class="form-input"
              placeholder="Ej: CEDH/2024/001234"
              autocomplete="off"
              aria-describedby="exp-hint"
            />
            <span id="exp-hint" class="form-hint">Ingresa el número tal como aparece en tu documento oficial.</span>
          </div>

          <button class="btn btn-primary search-btn" id="btn-buscar" onclick="buscarExpediente()">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            Consultar
          </button>
        </div>
      </div>

      <!-- Resultado / estado -->
      <div id="resultado" class="resultado-area" hidden aria-live="polite" aria-atomic="true">
        <!-- Se llena por JS -->
      </div>

      <!-- Leyenda semáforo -->
      <div class="leyenda" aria-label="Significado de los colores del semáforo">
        <h3 class="leyenda-title">¿Qué significa cada color?</h3>
        <div class="leyenda-grid">
          <div class="leyenda-item">
            <div class="leyenda-dot" style="background:var(--semaforo-verde)"></div>
            <div>
              <strong>Verde — Cumplida</strong>
              <p>La autoridad atendió completamente la recomendación. El proceso concluyó satisfactoriamente.</p>
            </div>
          </div>
          <div class="leyenda-item">
            <div class="leyenda-dot" style="background:var(--semaforo-amarillo)"></div>
            <div>
              <strong>Amarillo — En proceso</strong>
              <p>La autoridad está trabajando en atender la recomendación. Existe seguimiento activo.</p>
            </div>
          </div>
          <div class="leyenda-item">
            <div class="leyenda-dot" style="background:var(--semaforo-rojo)"></div>
            <div>
              <strong>Rojo — Pendiente</strong>
              <p>La autoridad aún no ha acreditado acciones concretas. Se requiere atención urgente.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<!-- Datos demo (en producción vendrán de API/CMS) -->
<script>
  import { withBase } from '../utils/url';

  // Datos demo — reemplazar con fetch a API real
  const datosDemo: Record<string, {
    tipo: string;
    expediente: string;
    asunto: string;
    autoridad: string;
    fechaEmision: string;
    estado: 'verde' | 'amarillo' | 'rojo';
    etiqueta: string;
    porcentaje: number;
    ultimaActualizacion: string;
    avances: { fecha: string; descripcion: string }[];
  }> = {
    'CEDH/2024/001234': {
      tipo: 'CEDH',
      expediente: 'CEDH/2024/001234',
      asunto: 'Violación al derecho a la salud',
      autoridad: 'Secretaría de Salud del Estado de Michoacán',
      fechaEmision: '15 de enero de 2024',
      estado: 'amarillo',
      etiqueta: 'En proceso',
      porcentaje: 60,
      ultimaActualizacion: '20 de julio de 2026',
      avances: [
        { fecha: 'Ene 2024', descripcion: 'Recomendación emitida por la CEDH.' },
        { fecha: 'Feb 2024', descripcion: 'Autoridad acepta la recomendación.' },
        { fecha: 'May 2024', descripcion: 'Primer informe de cumplimiento presentado.' },
        { fecha: 'Jul 2026', descripcion: 'Subsecretaría verifica acciones parciales. Seguimiento activo.' },
      ]
    },
    'CNDH/2023/005678': {
      tipo: 'CNDH',
      expediente: 'CNDH/2023/005678',
      asunto: 'Derecho a la integridad personal',
      autoridad: 'Municipio de Morelia',
      fechaEmision: '3 de junio de 2023',
      estado: 'verde',
      etiqueta: 'Cumplida',
      porcentaje: 100,
      ultimaActualizacion: '10 de mayo de 2026',
      avances: [
        { fecha: 'Jun 2023', descripcion: 'Recomendación emitida por la CNDH.' },
        { fecha: 'Ago 2023', descripcion: 'Autoridad acepta la recomendación.' },
        { fecha: 'Dic 2023', descripcion: 'Medidas de reparación implementadas.' },
        { fecha: 'May 2026', descripcion: 'Cumplimiento total verificado. Caso cerrado.' },
      ]
    },
    'CEDH/2025/000099': {
      tipo: 'CEDH',
      expediente: 'CEDH/2025/000099',
      asunto: 'Derecho a la educación',
      autoridad: 'Secretaría de Educación de Michoacán',
      fechaEmision: '22 de febrero de 2025',
      estado: 'rojo',
      etiqueta: 'Pendiente',
      porcentaje: 10,
      ultimaActualizacion: '25 de julio de 2026',
      avances: [
        { fecha: 'Feb 2025', descripcion: 'Recomendación emitida por la CEDH.' },
        { fecha: 'Mar 2025', descripcion: 'Autoridad recibe notificación oficial.' },
        { fecha: 'Jul 2026', descripcion: 'Sin acreditación de acciones. Subsecretaría en gestión.' },
      ]
    }
  };

  function buscarExpediente() {
    const numExp = (document.getElementById('num-exp') as HTMLInputElement)?.value.trim().toUpperCase();
    const tipo   = (document.getElementById('tipo-rec') as HTMLSelectElement)?.value;
    const area   = document.getElementById('resultado') as HTMLElement;

    if (!numExp) {
      mostrarError('Por favor ingresa el número de expediente.', area);
      return;
    }

    const datos = datosDemo[numExp];

    if (!datos) {
      mostrarError(`No encontramos el expediente <strong>${numExp}</strong>. Verifica que el número esté escrito correctamente tal como aparece en tu documento oficial. Si el problema persiste, <a href="${withBase('/contacto')}">contáctanos</a>.`, area);
      return;
    }

    const colores = {
      verde:    { bg: '#D1FAE5', border: '#2D7A4F', text: '#1A4731' },
      amarillo: { bg: '#FEF3C7', border: '#C87C00', text: '#5C3A00' },
      rojo:     { bg: '#FEE2E2', border: '#B91C1C', text: '#5A0000' },
    };

    const color = colores[datos.estado];

    area.innerHTML = `
      <div class="resultado-card" style="border-color:${color.border}">
        <div class="resultado-header" style="background:${color.bg};border-bottom:2px solid ${color.border}">
          <div class="resultado-estado">
            <div class="estado-dot" style="background:${color.border}">
              <div class="estado-ring" style="border-color:${color.border}"></div>
            </div>
            <div>
              <span class="estado-etiqueta" style="color:${color.text}">${datos.etiqueta}</span>
              <span class="resultado-exp">${datos.expediente}</span>
            </div>
          </div>
          <div class="resultado-porcentaje" style="color:${color.text}">${datos.porcentaje}% cumplido</div>
        </div>

        <div class="resultado-body">
          <div class="resultado-info">
            <div class="info-row">
              <span class="info-label">Asunto</span>
              <span class="info-value">${datos.asunto}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Autoridad responsable</span>
              <span class="info-value">${datos.autoridad}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Fecha de emisión</span>
              <span class="info-value">${datos.fechaEmision}</span>
            </div>
            <div class="info-row">
              <span class="info-label">Última actualización</span>
              <span class="info-value">${datos.ultimaActualizacion}</span>
            </div>
          </div>

          <div class="progreso-bar-wrap" aria-label="Progreso de cumplimiento: ${datos.porcentaje}%">
            <div class="progreso-bar" style="width:${datos.porcentaje}%;background:${color.border}"></div>
          </div>

          <h4 class="avances-title">Historial de avances</h4>
          <ol class="avances-list">
            ${datos.avances.map((a, i) => `
              <li class="avance-item ${i === datos.avances.length - 1 ? 'avance-ultimo' : ''}">
                <span class="avance-fecha">${a.fecha}</span>
                <span class="avance-desc">${a.descripcion}</span>
              </li>
            `).join('')}
          </ol>
        </div>
      </div>
    `;

    area.removeAttribute('hidden');
    area.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function mostrarError(msg: string, area: HTMLElement) {
    area.innerHTML = `
      <div class="resultado-error" role="alert">
        <span aria-hidden="true">⚠️</span>
        <div>${msg}</div>
      </div>
    `;
    area.removeAttribute('hidden');
    area.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // También buscar con Enter
  document.getElementById('num-exp')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') buscarExpediente();
  });
</script>

<style>
  .semaforo-hero {
    background: linear-gradient(135deg, var(--color-guinda) 0%, var(--color-morado) 100%);
    padding-block: var(--space-16);
    text-align: center;
  }

  .semaforo-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 900;
    color: var(--color-blanco);
    margin-block: var(--space-4) var(--space-4);
  }

  .semaforo-desc {
    color: rgba(255,255,255,0.80);
    max-width: 56ch;
    margin-inline: auto;
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  /* Search box */
  .search-box {
    background: var(--color-blanco);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-8);
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .search-header {
    margin-bottom: var(--space-6);
  }

  .search-header h2 {
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-bottom: var(--space-2);
  }

  .search-header p {
    color: var(--color-texto-muted);
    font-size: var(--text-sm);
  }

  .search-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-label {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-guinda);
    margin-bottom: var(--space-2);
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-salvia-light);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-texto);
    transition: border-color var(--transition-fast);
    background: var(--color-blanco);
  }

  .form-input:focus,
  .form-select:focus {
    outline: none;
    border-color: var(--color-guinda);
  }

  .form-hint {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-texto-muted);
    margin-top: var(--space-1);
  }

  .search-btn {
    width: 100%;
    justify-content: center;
    font-size: var(--text-lg);
    padding: var(--space-4);
  }

  /* Resultado */
  .resultado-area {
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: var(--space-12);
  }

  .resultado-card {
    border: 2px solid;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .resultado-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .resultado-estado {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .estado-dot {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
  }

  .estado-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid;
    animation: pulse-ring 2s ease-in-out infinite;
    opacity: 0.4;
  }

  .estado-etiqueta {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 900;
  }

  .resultado-exp {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
    font-family: monospace;
  }

  .resultado-porcentaje {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 900;
  }

  .resultado-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background: var(--color-blanco);
  }

  .resultado-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .info-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-4);
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--color-salvia-light);
    padding-bottom: var(--space-3);
  }

  .info-label {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-salvia);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .progreso-bar-wrap {
    height: 10px;
    background: var(--color-salvia-light);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progreso-bar {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 1s ease;
  }

  .avances-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-guinda);
  }

  .avances-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    counter-reset: avance;
    list-style: none;
  }

  .avance-item {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-fondo);
  }

  .avance-ultimo {
    background: var(--color-rosa-light);
    font-weight: 500;
  }

  .avance-fecha {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-salvia);
    white-space: nowrap;
    min-width: 70px;
    font-size: var(--text-xs);
    padding-top: 2px;
  }

  .resultado-error {
    display: flex;
    gap: var(--space-4);
    background: #FEF3C7;
    border: 2px solid #C87C00;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    color: #5C3A00;
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* Leyenda */
  .leyenda {
    max-width: 680px;
    margin-inline: auto;
    padding: var(--space-8);
    background: var(--color-blanco);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .leyenda-title {
    font-size: var(--text-lg);
    font-weight: 800;
    margin-bottom: var(--space-6);
    color: var(--color-guinda);
  }

  .leyenda-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .leyenda-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .leyenda-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .leyenda-item strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-guinda);
    margin-bottom: var(--space-1);
  }

  .leyenda-item p {
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
    line-height: 1.6;
  }
</style>
