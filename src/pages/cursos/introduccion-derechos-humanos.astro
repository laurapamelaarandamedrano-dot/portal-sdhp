---

<BaseLayout
  title={curso.titulo}
  description={curso.descripcion}
>

  <!-- Header del curso -->
  <section class="curso-hero" aria-label="Información del curso">
    <div class="container">
      <a href={withBase('/cursos')} class="curso-back">← Regresar al catálogo</a>
      <div class="curso-hero-inner">
        <div class="curso-hero-emoji" aria-hidden="true">{curso.emoji}</div>
        <div>
          <span class="badge badge-rosa">Disponible ahora</span>
          <h1 class="curso-hero-title">{curso.titulo}</h1>
          <p class="curso-hero-desc">{curso.descripcion}</p>
          <div class="curso-hero-meta">
            <span>📚 {curso.modulos.length} módulos</span>
            <span>⏱ ~3 horas</span>
            <span>🆓 Gratuito</span>
            <span>📄 Constancia PDF</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cuerpo del curso -->
  <section class="section" aria-label="Contenido del curso">
    <div class="container curso-layout">

      <!-- Sidebar: índice de módulos -->
      <aside class="modulos-sidebar" aria-label="Índice del curso">
        <div class="sidebar-inner">
          <button
            type="button"
            class="sidebar-toggle"
            id="sidebar-toggle"
            aria-expanded="false"
            aria-controls="sidebar-collapsible"
          >
            <span class="sidebar-title">Módulos</span>
            <span class="sidebar-toggle-icon" aria-hidden="true">▾</span>
          </button>

          <div class="sidebar-collapsible" id="sidebar-collapsible">
            <ol class="modulos-index" id="modulos-index">
              {curso.modulos.map(m => (
                <li>
                  <button
                    class="modulo-index-btn js-ir-modulo"
                    data-modulo={m.id}
                    data-target={m.id}
                    aria-label={`Módulo ${m.id}: ${m.titulo}`}
                  >
                    <span class="modulo-num">{m.id}</span>
                    <span class="modulo-index-titulo">{m.titulo}</span>
                    <span class="modulo-check" id={`check-${m.id}`} hidden aria-hidden="true">✓</span>
                  </button>
                </li>
              ))}
            </ol>

            <!-- Progreso -->
            <div class="sidebar-progreso">
              <div class="progreso-label">
                <span>Progreso</span>
                <span id="progreso-pct">0%</span>
              </div>
              <div class="progreso-bar-wrap" role="progressbar" aria-valuemin={0} aria-valuemax={100} aria-valuenow={0} id="progreso-bar-wrap">
                <div class="progreso-bar" id="progreso-bar" style="width:0%"></div>
              </div>
            </div>

            <button type="button" class="btn-reiniciar" id="btn-reiniciar-curso">
              ↺ Reiniciar curso
            </button>
          </div>
        </div>
      </aside>

      <!-- Contenido principal -->
      <div class="curso-main">
        {curso.modulos.map((modulo, idx) => (
          <article
            class="modulo-card"
            id={`modulo-${modulo.id}`}
            data-modulo-id={modulo.id}
            hidden={idx !== 0}
          >
            <div class="modulo-header">
              <span class="modulo-numero">Módulo {modulo.id} de {curso.modulos.length}</span>
              <h2 class="modulo-titulo">{modulo.titulo}</h2>
            </div>

            <div class="modulo-contenido" set:html={modulo.contenido.map(renderBloque).join('')} />

            <!-- Quiz -->
            <div class="quiz-area" id={`quiz-${modulo.id}`}>
              <div class="quiz-header">
                <span class="quiz-label">🧠 Quiz del módulo</span>
                <p class="quiz-pregunta">{modulo.quiz.pregunta}</p>
              </div>
              <div class="quiz-opciones" role="radiogroup" aria-label="Opciones de respuesta">
                {modulo.quiz.opciones.map((op, i) => (
                  <button
                    class="quiz-opcion"
                    data-modulo={modulo.id}
                    data-opcion={i}
                    data-correcta={modulo.quiz.correcta}
                  >
                    <span class="quiz-opcion-letra" aria-hidden="true">{String.fromCharCode(65 + i)}</span>
                    {op}
                  </button>
                ))}
              </div>
              <div class="quiz-feedback" id={`fb-${modulo.id}`} hidden></div>
            </div>

            <!-- Navegación módulo -->
            <div class="modulo-nav">
              {idx > 0 && (
                <button class="btn btn-secondary js-ir-modulo" data-target={modulo.id - 1}>
                  ← Módulo anterior
                </button>
              )}
              {idx < curso.modulos.length - 1 ? (
                <button
                  class="btn btn-primary modulo-siguiente js-ir-modulo"
                  id={`siguiente-${modulo.id}`}
                  data-target={modulo.id + 1}
                  disabled
                  aria-label={`Ir al módulo ${modulo.id + 1}`}
                >
                  Siguiente módulo →
                </button>
              ) : (
                <button
                  class="btn btn-primary modulo-siguiente js-generar-constancia"
                  id={`siguiente-${modulo.id}`}
                  disabled
                >
                  🎉 Obtener constancia
                </button>
              )}
            </div>
          </article>
        ))}

        <!-- Pantalla de constancia -->
        <div id="pantalla-constancia" hidden>
          <div class="constancia-hero">
            <div class="constancia-icon" aria-hidden="true" id="constancia-icon">🏆</div>
            <h2 id="constancia-titulo">¡Felicidades, lo lograste!</h2>
            <p>Completaste el curso <strong>{NOMBRE_CONSTANCIA}</strong>.</p>
            <p class="constancia-calificacion" id="constancia-calificacion"></p>

            <!-- Se muestra solo si la calificación final es >= 80% -->
            <div class="constancia-actions" id="constancia-actions" hidden>
              <button type="button" class="btn btn-primary js-descargar-constancia">
                📄 Descargar constancia PDF
              </button>
              <a href={withBase('/cursos')} class="btn btn-secondary">Ver más cursos</a>
            </div>

            <!-- Se muestra solo si la calificación final es < 80% -->
            <div class="constancia-reintentar" id="constancia-reintentar" hidden>
              <p>
                Necesitas al menos <strong>80% de aciertos</strong> en los quizzes para obtener
                tu constancia. Vuelve a los módulos donde fallaste, presiona
                "↺ Intentar de nuevo" en el quiz y contesta otra vez — no perderás tu avance.
              </p>
              <button type="button" class="btn btn-secondary js-ir-modulo" data-target="1">
                Repasar desde el módulo 1
              </button>
            </div>
          </div>

          <!-- Se muestra solo si la calificación final es >= 80% -->
          <div id="constancia-descarga-zona" hidden>
            <div class="constancia-nombre-form">
              <label for="nombre-constancia" class="form-label">¿A nombre de quién es la constancia?</label>
              <input
                type="text"
                id="nombre-constancia"
                class="form-input"
                placeholder="Escribe tu nombre completo"
                autocomplete="off"
                maxlength="100"
                inputmode="text"
                style="max-width:400px"
              />
              <span class="form-hint">Solo letras, espacios y acentos, máximo 100 caracteres. Este dato solo se usa para tu constancia; no se guarda en ningún lado.</span>
            </div>

            <!-- Vista previa constancia: orientación horizontal, proporción tipo diploma -->
            <div class="constancia-preview-scroll">
              <div class="constancia-preview" id="constancia-preview">
                <div class="const-header">
                  <div class="const-logo-area">
                    <div class="const-escudo" aria-hidden="true">🏛</div>
                    <div>
                      <div class="const-inst">Subsecretaría de Derechos Humanos y Población</div>
                      <div class="const-gov">Gobierno de Michoacán</div>
                    </div>
                  </div>
                  <div class="const-sello" aria-hidden="true">DDHH<br />MICH</div>
                </div>

                <p class="const-titulo-doc">Constancia de Participación</p>

                <div class="const-body">
                  <div class="const-body-principal">
                    <p class="const-texto-certifica">Se otorga la presente constancia a:</p>
                    <p class="const-nombre" id="const-nombre">_____________________</p>
                    <p class="const-texto">por haber completado satisfactoriamente el</p>
                    <p class="const-curso">{NOMBRE_CONSTANCIA}</p>
                  </div>

                  <div class="const-body-datos">
                    <p class="const-fecha" id="const-fecha"></p>
                    <p class="const-calificacion" id="const-calificacion"></p>

                    <div class="const-firma">
                      <div class="const-firma-linea"></div>
                      <p class="const-firma-titulo">Subsecretario de Derechos Humanos y Población</p>
                      <p class="const-firma-sub">Gobierno del Estado de Michoacán</p>
                    </div>

                    <p class="const-folio" id="const-folio"></p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import { guardarProgreso, obtenerProgreso, obtenerCorrectas, limpiarProgreso } from '../../utils/cursoStorage.js';
  import { jsPDF } from 'jspdf';
  import html2canvas from 'html2canvas';

  const CURSO_ID = 'intro';
  const totalModulos = 6;
  const CALIFICACION_MINIMA = 80;
  // Debe coincidir con NOMBRE_CONSTANCIA en el frontmatter de esta página
  // (el <script> del cliente no puede leer variables del frontmatter).
  const NOMBRE_CONSTANCIA = 'Curso Básico de Derechos Humanos';
  let completados = new Set<number>();
  let correctas = new Set<number>();
  let moduloActual = 1;

  function irModulo(id: number) {
    document.querySelectorAll('.modulo-card').forEach(el => el.setAttribute('hidden', ''));
    document.getElementById('pantalla-constancia')?.setAttribute('hidden', '');

    document.getElementById(`modulo-${id}`)?.removeAttribute('hidden');
    moduloActual = id;

    document.querySelector('.curso-main')?.scrollIntoView({ behavior: 'smooth', block: 'start' });

    document.querySelectorAll('.modulo-index-btn').forEach(btn => {
      btn.classList.toggle('active', Number(btn.getAttribute('data-modulo')) === id);
    });

    cerrarSidebar();
  }

  function toggleSidebar() {
    const toggle = document.getElementById('sidebar-toggle');
    const panel  = document.getElementById('sidebar-collapsible');
    const abierto = toggle?.getAttribute('aria-expanded') === 'true';
    toggle?.setAttribute('aria-expanded', String(!abierto));
    panel?.classList.toggle('is-open', !abierto);
  }

  function cerrarSidebar() {
    document.getElementById('sidebar-toggle')?.setAttribute('aria-expanded', 'false');
    document.getElementById('sidebar-collapsible')?.classList.remove('is-open');
  }

  function responderQuiz(btn: HTMLElement) {
    const moduloId = Number(btn.getAttribute('data-modulo'));
    const opcion   = Number(btn.getAttribute('data-opcion'));
    const correcta = Number(btn.getAttribute('data-correcta'));
    const area = btn.closest('.quiz-area');
    const feedback = document.getElementById(`fb-${moduloId}`);
    const esCorrecta = opcion === correcta;

    area?.querySelectorAll('.quiz-opcion').forEach((b, i) => {
      (b as HTMLButtonElement).disabled = true;
      if (i === correcta) b.classList.add('opcion-correcta');
      else if (i === opcion) b.classList.add('opcion-incorrecta');
    });

    if (feedback) {
      feedback.removeAttribute('hidden');
      feedback.className = `quiz-feedback quiz-feedback-${esCorrecta ? 'ok' : 'error'}`;
      // Construido con texto plano (no innerHTML con datos externos): el
      // contenido aquí es siempre fijo, nunca proviene del usuario.
      feedback.textContent = '';
      const textoSpan = document.createElement('span');
      textoSpan.textContent = esCorrecta
        ? '✅ ¡Correcto! Puedes continuar al siguiente módulo.'
        : '💜 No es la respuesta que buscábamos, pero lo importante es seguir aprendiendo. La respuesta correcta está marcada en verde.';
      feedback.appendChild(textoSpan);

      const btnReintentar = document.createElement('button');
      btnReintentar.type = 'button';
      btnReintentar.className = 'quiz-reintentar-btn';
      btnReintentar.textContent = '↺ Intentar de nuevo';
      btnReintentar.addEventListener('click', () => reintentarQuiz(moduloId));
      feedback.appendChild(btnReintentar);
    }

    // El quiz nunca bloquea el avance: responder (bien o mal) siempre
    // marca el módulo como completado y habilita continuar. La calificación
    // final (para la constancia) sí distingue aciertos de errores.
    completados.add(moduloId);
    if (esCorrecta) correctas.add(moduloId);
    else correctas.delete(moduloId);
    guardarProgreso(CURSO_ID, moduloId, esCorrecta);
    document.getElementById(`check-${moduloId}`)?.removeAttribute('hidden');
    document.getElementById(`siguiente-${moduloId}`)?.removeAttribute('disabled');

    actualizarProgreso();
  }

  function reintentarQuiz(moduloId: number) {
    const area = document.getElementById(`quiz-${moduloId}`);
    area?.querySelectorAll<HTMLButtonElement>('.quiz-opcion').forEach(b => {
      b.disabled = false;
      b.classList.remove('opcion-correcta', 'opcion-incorrecta');
    });
    document.getElementById(`fb-${moduloId}`)?.setAttribute('hidden', '');
  }

  function calificacionFinal(): number {
    return Math.round((correctas.size / totalModulos) * 100);
  }

  function actualizarProgreso() {
    const pct = Math.round((completados.size / totalModulos) * 100);
    const bar   = document.getElementById('progreso-bar') as HTMLElement;
    const label = document.getElementById('progreso-pct');
    const wrap  = document.getElementById('progreso-bar-wrap');

    if (bar) bar.style.width = `${pct}%`;
    if (label) label.textContent = `${pct}%`;
    if (wrap) wrap.setAttribute('aria-valuenow', String(pct));
  }

  function generarConstancia() {
    document.querySelectorAll('.modulo-card').forEach(el => el.setAttribute('hidden', ''));
    document.getElementById('pantalla-constancia')?.removeAttribute('hidden');

    const calificacion = calificacionFinal();
    const aprobo = calificacion >= CALIFICACION_MINIMA;

    const elCalificacionHero = document.getElementById('constancia-calificacion');
    if (elCalificacionHero) elCalificacionHero.textContent = `Tu calificación final: ${calificacion}% de aciertos`;

    const elTitulo = document.getElementById('constancia-titulo');
    if (elTitulo) elTitulo.textContent = aprobo ? '¡Felicidades, lo lograste!' : 'Ya casi lo logras';

    const elIcono = document.getElementById('constancia-icon');
    if (elIcono) elIcono.textContent = aprobo ? '🏆' : '💪';

    // La descarga (y todo lo necesario para generarla) solo se muestra si
    // la calificación final alcanza el mínimo requerido.
    document.getElementById('constancia-actions')?.toggleAttribute('hidden', !aprobo);
    document.getElementById('constancia-descarga-zona')?.toggleAttribute('hidden', !aprobo);
    document.getElementById('constancia-reintentar')?.toggleAttribute('hidden', aprobo);

    if (aprobo) {
      // Fecha y calificación se muestran de inmediato en la vista previa.
      // El folio se genera aparte, al momento de descargar (incorpora el
      // nombre exacto que la persona haya escrito en ese momento).
      const fecha = new Date().toLocaleDateString('es-MX', {
        year: 'numeric', month: 'long', day: 'numeric',
      });
      const elFecha = document.getElementById('const-fecha');
      if (elFecha) elFecha.textContent = `Michoacán, ${fecha}`;

      const elCalificacion = document.getElementById('const-calificacion');
      if (elCalificacion) elCalificacion.textContent = `Calificación obtenida: ${calificacion}%`;

      const elFolio = document.getElementById('const-folio');
      if (elFolio) elFolio.textContent = 'Folio: se genera al descargar';
    }

    document.getElementById('pantalla-constancia')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Permite solo letras (con acentos), espacios y ñ; recorta a 100 caracteres.
  function sanitizarNombreEntrada(valor: string): string {
    return valor.replace(/[^A-Za-zÀ-ÿ\s]/g, '').slice(0, 100);
  }

  function actualizarNombre(valor: string) {
    // Solo se refleja en pantalla vía textContent (nunca innerHTML con datos
    // del usuario) y nunca se guarda en localStorage ni se envía a ningún lado.
    const el = document.getElementById('const-nombre');
    if (el) el.textContent = valor || '_____________________';
  }

  // Hash corto y determinístico (no criptográfico) para el folio — no
  // depende de ningún servicio externo, solo corre en el navegador.
  function hashCorto(texto: string): string {
    let hash = 0;
    for (let i = 0; i < texto.length; i++) {
      hash = (hash * 31 + texto.charCodeAt(i)) >>> 0;
    }
    return hash.toString(36).toUpperCase();
  }

  // Quita acentos y cualquier carácter que no sea letra/número, para usarlo
  // en el nombre del archivo descargado.
  function sanitizarNombreArchivo(texto: string): string {
    return texto
      .normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[^a-zA-Z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .toLowerCase() || 'constancia';
  }

  async function descargarConstanciaPDF() {
    const boton = document.querySelector<HTMLButtonElement>('.js-descargar-constancia');
    const nombreInput = document.getElementById('nombre-constancia') as HTMLInputElement | null;
    const nombre = sanitizarNombreEntrada(nombreInput?.value ?? '').trim();

    if (!nombre) {
      window.alert('Por favor escribe tu nombre antes de descargar la constancia.');
      nombreInput?.focus();
      return;
    }

    // Folio local (hash corto de nombre + fecha + momento exacto) — no
    // identifica a la persona por sí solo y no llama a ningún servicio externo.
    // (Fecha y calificación ya se muestran desde generarConstancia(); aquí
    // solo se genera el folio, que sí depende del nombre exacto tecleado.)
    const ahora = new Date();
    const folio = hashCorto(`${nombre}|${ahora.toISOString()}|${Date.now()}`);
    const elFolio = document.getElementById('const-folio');
    if (elFolio) elFolio.textContent = `Folio: ${folio}`;

    const elemento = document.getElementById('constancia-preview');
    if (!elemento) return;

    const textoOriginalBoton = boton?.textContent ?? '📄 Descargar constancia PDF';
    if (boton) {
      boton.disabled = true;
      boton.textContent = 'Generando PDF...';
    }

    try {
      const canvas = await html2canvas(elemento, {
        scale: 2,
        backgroundColor: '#FFFFFF',
      });

      // JPEG con buena calidad en vez de PNG: el certificado no tiene
      // transparencias y así el PDF pesa una fracción de lo que pesaría en PNG.
      const imagenDatos = canvas.toDataURL('image/jpeg', 0.92);

      // Orientación horizontal, proporción tipo diploma (A4 landscape).
      const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
      const anchoPagina = pdf.internal.pageSize.getWidth();
      const altoPagina = pdf.internal.pageSize.getHeight();
      const margen = 10;

      const relacion = canvas.width / canvas.height;
      let anchoImagen = anchoPagina - margen * 2;
      let altoImagen = anchoImagen / relacion;
      if (altoImagen > altoPagina - margen * 2) {
        altoImagen = altoPagina - margen * 2;
        anchoImagen = altoImagen * relacion;
      }
      const x = (anchoPagina - anchoImagen) / 2;
      const y = (altoPagina - altoImagen) / 2;

      pdf.addImage(imagenDatos, 'JPEG', x, y, anchoImagen, altoImagen);

      const nombreArchivo = `constancia-${sanitizarNombreArchivo(NOMBRE_CONSTANCIA)}-${sanitizarNombreArchivo(nombre)}.pdf`;
      pdf.save(nombreArchivo);
    } catch (error) {
      console.error('Error generando la constancia en PDF:', error);
      window.alert('Ocurrió un problema generando tu constancia. Por favor intenta de nuevo.');
    } finally {
      if (boton) {
        boton.disabled = false;
        boton.textContent = textoOriginalBoton;
      }
    }
  }

  function reiniciarCurso() {
    const confirmado = window.confirm('¿Seguro que quieres reiniciar tu progreso en este curso? Se perderán tus respuestas guardadas.');
    if (!confirmado) return;

    limpiarProgreso(CURSO_ID);
    completados.clear();
    correctas.clear();

    document.querySelectorAll('.modulo-check').forEach(el => el.setAttribute('hidden', ''));
    document.querySelectorAll<HTMLButtonElement>('.modulo-siguiente').forEach(btn => btn.setAttribute('disabled', ''));
    document.querySelectorAll<HTMLButtonElement>('.quiz-opcion').forEach(btn => {
      btn.disabled = false;
      btn.classList.remove('opcion-correcta', 'opcion-incorrecta');
    });
    document.querySelectorAll('.quiz-feedback').forEach(fb => fb.setAttribute('hidden', ''));

    actualizarProgreso();
    irModulo(1);
  }

  // ── Restaurar progreso guardado en localStorage ──
  obtenerProgreso(CURSO_ID).forEach(moduloId => {
    completados.add(moduloId);
    document.getElementById(`check-${moduloId}`)?.removeAttribute('hidden');
    document.getElementById(`siguiente-${moduloId}`)?.removeAttribute('disabled');
  });
  obtenerCorrectas(CURSO_ID).forEach(moduloId => correctas.add(moduloId));
  actualizarProgreso();

  // ── Wiring de eventos (sin onclick/oninput inline: este <script> es un
  // módulo ES y sus funciones no quedan expuestas en window) ──
  document.getElementById('sidebar-toggle')?.addEventListener('click', toggleSidebar);

  document.querySelectorAll<HTMLButtonElement>('.js-ir-modulo').forEach(btn => {
    btn.addEventListener('click', () => irModulo(Number(btn.getAttribute('data-target'))));
  });

  document.querySelectorAll<HTMLButtonElement>('.quiz-opcion').forEach(btn => {
    btn.addEventListener('click', () => responderQuiz(btn));
  });

  document.querySelectorAll<HTMLButtonElement>('.js-generar-constancia').forEach(btn => {
    btn.addEventListener('click', generarConstancia);
  });

  document.querySelectorAll<HTMLButtonElement>('.js-descargar-constancia').forEach(btn => {
    btn.addEventListener('click', () => { void descargarConstanciaPDF(); });
  });

  document.getElementById('nombre-constancia')?.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    const limpio = sanitizarNombreEntrada(input.value);
    if (limpio !== input.value) input.value = limpio;
    actualizarNombre(limpio);
  });

  document.getElementById('btn-reiniciar-curso')?.addEventListener('click', reiniciarCurso);

  // Activar primer módulo en el índice
  document.querySelector('[data-modulo="1"]')?.classList.add('active');
</script>

