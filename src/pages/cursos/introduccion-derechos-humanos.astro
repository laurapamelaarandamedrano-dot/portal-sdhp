---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/url';

// ── Identidad del curso para localStorage (ver src/utils/cursoStorage.js) ──
const CURSO_ID = 'intro';

// El nombre mostrado en la constancia es distinto al título de la página/curso.
const NOMBRE_CONSTANCIA = 'Curso Básico de Derechos Humanos';

type BloqueContenido =
  | { tipo: 'parrafo'; texto: string }
  | { tipo: 'subtitulo'; texto: string }
  | { tipo: 'cita'; texto: string; autor: string }
  | { tipo: 'reflexion'; texto: string }
  | { tipo: 'destacado'; titulo: string; texto: string }
  | { tipo: 'lista'; items: string[] }
  | { tipo: 'lista-numerada'; items: string[] }
  | { tipo: 'timeline'; eventos: { anio: string; texto: string }[] }
  | { tipo: 'comparativa'; columnas: string[]; filas: { nombre: string; valores: string[] }[] }
  | { tipo: 'generaciones'; items: { numero: number; titulo: string; epoca: string; descripcion: string; ejemplos: string[] }[] }
  | { tipo: 'piramide'; niveles: { nivel: string; descripcion: string }[] }
  | { tipo: 'contactos'; items: { nombre: string; telefono: string }[] };

function escapeHtml(texto: string): string {
  return texto.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// Convierte **negritas** estilo markdown a <strong>, escapando el resto.
function inline(texto: string): string {
  return escapeHtml(texto).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}

function renderBloque(b: BloqueContenido): string {
  switch (b.tipo) {
    case 'parrafo':
      return `<p>${inline(b.texto)}</p>`;

    case 'subtitulo':
      return `<h3 class="modulo-subtitulo">${inline(b.texto)}</h3>`;

    case 'cita':
      return `<blockquote class="modulo-cita"><p>“${inline(b.texto)}”</p><cite>— ${inline(b.autor)}</cite></blockquote>`;

    case 'reflexion':
      return `<p class="modulo-reflexion">${inline(b.texto)}</p>`;

    case 'destacado':
      return `<div class="modulo-destacado"><strong class="modulo-destacado-titulo">${inline(b.titulo)}</strong><p>${inline(b.texto)}</p></div>`;

    case 'lista':
      return `<ul class="modulo-lista">${b.items.map(i => `<li>${inline(i)}</li>`).join('')}</ul>`;

    case 'lista-numerada':
      return `<ol class="modulo-lista-numerada">${b.items.map(i => `<li>${inline(i)}</li>`).join('')}</ol>`;

    case 'timeline':
      return `<ol class="modulo-timeline">${b.eventos.map(e => `
        <li class="timeline-item">
          <span class="timeline-anio">${inline(e.anio)}</span>
          <span class="timeline-texto">${inline(e.texto)}</span>
        </li>`).join('')}</ol>`;

    // TODO: los valores de esta tabla comparativa (Derechos Humanos / Derechos
    // Fundamentales / Garantías) son una redacción pedagógica propia a partir
    // de los encabezados solicitados; verificar contra el material oficial del
    // curso antes de publicar como versión definitiva.
    case 'comparativa':
      return `<div class="modulo-comparativa">${b.filas.map(fila => `
        <div class="comparativa-card">
          <h4 class="comparativa-nombre">${inline(fila.nombre)}</h4>
          <dl class="comparativa-lista">
            ${b.columnas.map((col, i) => `
              <div class="comparativa-item">
                <dt>${inline(col)}</dt>
                <dd>${inline(fila.valores[i] ?? '')}</dd>
              </div>
            `).join('')}
          </dl>
        </div>
      `).join('')}</div>`;

    case 'generaciones':
      return `<div class="modulo-generaciones">${b.items.map(g => `
        <div class="generacion-card generacion-${g.numero}">
          <span class="generacion-numero">${g.numero}ª</span>
          <h4 class="generacion-titulo">${inline(g.titulo)}</h4>
          <span class="generacion-epoca">${inline(g.epoca)}</span>
          <p class="generacion-desc">${inline(g.descripcion)}</p>
          <ul class="generacion-ejemplos">${g.ejemplos.map(e => `<li>${inline(e)}</li>`).join('')}</ul>
        </div>
      `).join('')}</div>`;

    case 'piramide': {
      const colores = ['var(--color-guinda)', 'var(--color-morado)', 'var(--color-salvia)', '#8B6F5E', '#9CA89F'];
      return `<div class="modulo-piramide">${b.niveles.map((n, i) => `
        <div class="piramide-nivel" style="background:${colores[i] ?? 'var(--color-salvia)'};width:${Math.max(40, 100 - i * 15)}%">
          <span class="piramide-etiqueta">${inline(n.nivel)}</span>
          <p class="piramide-desc">${inline(n.descripcion)}</p>
        </div>
      `).join('')}</div>`;
    }

    case 'contactos':
      return `<div class="modulo-contactos">${b.items.map(c => `
        <a class="contacto-chip" href="tel:${c.telefono.replace(/\s+/g, '')}">
          <span class="contacto-chip-nombre">${inline(c.nombre)}</span>
          <span class="contacto-chip-tel">${inline(c.telefono)}</span>
        </a>
      `).join('')}</div>`;

    default:
      return '';
  }
}

interface Modulo {
  id: number;
  titulo: string;
  contenido: BloqueContenido[];
