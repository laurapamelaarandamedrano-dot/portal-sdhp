    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .curso-hero-meta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-rosa-light);
  }

  /* Layout */
  .curso-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 900px) {
    .curso-layout { grid-template-columns: 280px 1fr; gap: var(--space-8); }
  }

  /* Sidebar */
  .modulos-sidebar {
    position: static;
  }

  @media (min-width: 900px) {
    .modulos-sidebar {
      position: sticky;
      top: calc(64px + var(--space-4));
    }
  }

  .sidebar-inner {
    background: var(--color-blanco);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: clamp(1rem, 4vw, var(--space-6));
  }

  /* Toggle acordeón (solo visible/funcional en móvil) */
  .sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    min-height: 48px;
    cursor: default;
  }

  .sidebar-title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-salvia);
  }

  .sidebar-toggle-icon {
    display: none;
    font-size: var(--text-lg);
    color: var(--color-guinda);
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .sidebar-collapsible {
    padding-top: var(--space-4);
  }

  @media (max-width: 899px) {
    .sidebar-toggle {
      cursor: pointer;
    }

    .sidebar-toggle-icon {
      display: inline-block;
    }

    .sidebar-toggle[aria-expanded="true"] .sidebar-toggle-icon {
      transform: rotate(180deg);
    }

    .sidebar-collapsible {
      display: none;
    }

    .sidebar-collapsible.is-open {
      display: block;
    }
  }

  .modulos-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-6);
    counter-reset: modulo;
  }

  .modulo-index-btn {
    width: 100%;
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
    text-align: left;
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .modulo-index-btn:hover,
  .modulo-index-btn.active {
    background: var(--color-rosa-light);
    color: var(--color-guinda);
  }

  .modulo-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-salvia-light);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    flex-shrink: 0;
    color: var(--color-salvia);
  }

  .modulo-index-btn.active .modulo-num {
    background: var(--color-guinda);
    color: var(--color-blanco);
  }

  .modulo-index-titulo {
    flex: 1;
    line-height: 1.3;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }

  .modulo-check {
    color: var(--semaforo-verde);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Progreso sidebar */
  .sidebar-progreso {
    border-top: 1px solid var(--color-salvia-light);
    padding-top: var(--space-4);
  }

  .progreso-label {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-salvia);
    margin-bottom: var(--space-2);
  }

  .progreso-bar-wrap {
    height: 8px;
    background: var(--color-salvia-light);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progreso-bar {
    height: 100%;
    background: var(--color-guinda);
    border-radius: var(--radius-full);
    transition: width 0.6s ease;
  }

  .btn-reiniciar {
    width: 100%;
    min-height: 44px;
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: 2px solid var(--color-salvia-light);
    background: transparent;
    color: var(--color-salvia);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-reiniciar:hover {
    border-color: var(--color-guinda);
    color: var(--color-guinda);
    background: var(--color-fondo-alt);
  }

  /* Tarjeta de módulo */
  .modulo-card {
    background: var(--color-blanco);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .modulo-header {
    background: linear-gradient(135deg, var(--color-guinda), var(--color-morado));
    padding: clamp(1rem, 4vw, var(--space-6)) clamp(1rem, 5vw, var(--space-8));
  }

  .modulo-numero {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-rosa);
    display: block;
    margin-bottom: var(--space-2);
  }

  .modulo-titulo {
    font-size: clamp(1.25rem, 5vw, var(--text-2xl));
    font-weight: 900;
    line-height: 1.25;
    color: var(--color-blanco);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .modulo-contenido {
    padding: clamp(1.25rem, 5vw, var(--space-8));
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-texto);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .modulo-contenido :global(p) { margin-bottom: var(--space-4); }
  .modulo-contenido :global(strong) { color: var(--color-guinda); }
  .modulo-contenido :global(ul) {
    margin-block: var(--space-3);
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .modulo-contenido :global(li) {
    position: relative;
    padding-left: var(--space-4);
    font-size: var(--text-sm);
    list-style: disc;
    list-style-position: outside;
    color: var(--color-texto-muted);
    line-height: 1.6;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Subtítulos, citas, destacados y reflexión dentro del contenido */
  .modulo-contenido :global(.modulo-subtitulo) {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-guinda);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .modulo-contenido :global(.modulo-cita) {
    border-left: 4px solid var(--color-rosa);
    background: var(--color-rosa-light);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-md);
    margin-block: var(--space-4);
  }
  .modulo-contenido :global(.modulo-cita p) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-guinda);
    font-style: italic;
    line-height: 1.5;
    margin-bottom: var(--space-2);
  }
  .modulo-contenido :global(.modulo-cita cite) {
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
    font-style: normal;
  }

  .modulo-contenido :global(.modulo-reflexion) {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-guinda);
    padding-block: var(--space-6);
    font-style: italic;
  }

  .modulo-contenido :global(.modulo-destacado) {
    background: var(--color-fondo-alt);
    border: 2px solid var(--color-salvia-light);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-block: var(--space-4);
  }
  .modulo-contenido :global(.modulo-destacado-titulo) {
    display: block;
    font-family: var(--font-display);
    color: var(--color-guinda);
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .modulo-contenido :global(.modulo-destacado p) {
    color: var(--color-texto);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .modulo-contenido :global(.modulo-lista-numerada) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block: var(--space-3);
    padding-left: var(--space-5);
  }
  .modulo-contenido :global(.modulo-lista-numerada li) {
    list-style: decimal;
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
    line-height: 1.6;
  }

  /* Timeline */
  .modulo-contenido :global(.modulo-timeline) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-block: var(--space-4);
    border-left: 3px solid var(--color-salvia-light);
    padding-left: var(--space-5);
  }
  .modulo-contenido :global(.timeline-item) { position: relative; }
  .modulo-contenido :global(.timeline-item::before) {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-5) - 5px);
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-guinda);
  }
  .modulo-contenido :global(.timeline-anio) {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--color-guinda);
    font-size: var(--text-sm);
  }
  .modulo-contenido :global(.timeline-texto) {
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
  }

  /* Tabla comparativa (como tarjetas, no <table>) */
  .modulo-contenido :global(.modulo-comparativa) {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .modulo-contenido :global(.modulo-comparativa) { grid-template-columns: repeat(3, 1fr); }
  }
  .modulo-contenido :global(.comparativa-card) {
    background: var(--color-fondo-alt);
    border: 2px solid var(--color-salvia-light);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  .modulo-contenido :global(.comparativa-nombre) {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-guinda);
    margin-bottom: var(--space-3);
  }
  .modulo-contenido :global(.comparativa-lista) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .modulo-contenido :global(.comparativa-item dt) {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-salvia);
  }
  .modulo-contenido :global(.comparativa-item dd) {
    font-size: var(--text-sm);
    color: var(--color-texto);
    margin: 0;
  }

  /* Generaciones */
  .modulo-contenido :global(.modulo-generaciones) {
    display: grid;
    gap: var(--space-4);
    margin-block: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .modulo-contenido :global(.modulo-generaciones) { grid-template-columns: 1fr 1fr; }
  }
  .modulo-contenido :global(.generacion-card) {
    border-radius: var(--radius-md);
    padding: var(--space-5);
    color: var(--color-blanco);
  }
  .modulo-contenido :global(.generacion-1) { background: var(--color-guinda); }
  .modulo-contenido :global(.generacion-2) { background: var(--color-morado); }
  .modulo-contenido :global(.generacion-3) { background: var(--color-salvia); }
  .modulo-contenido :global(.generacion-4) { background: var(--color-guinda-dark); }
  .modulo-contenido :global(.generacion-numero) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-rosa);
  }
  .modulo-contenido :global(.generacion-titulo) {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-blanco);
    margin-block: var(--space-1);
  }
  .modulo-contenido :global(.generacion-epoca) {
    display: block;
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.70);
    margin-bottom: var(--space-3);
  }
  .modulo-contenido :global(.generacion-desc) {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.90);
    margin-bottom: var(--space-3);
  }
  .modulo-contenido :global(.generacion-ejemplos) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-left: 0;
  }
  .modulo-contenido :global(.generacion-ejemplos li) {
    list-style: none;
    padding-left: 0;
    font-size: var(--text-xs);
    background: rgba(255,255,255,0.15);
    color: var(--color-blanco);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  /* Pirámide normativa */
  .modulo-contenido :global(.modulo-piramide) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-block: var(--space-4);
  }
  .modulo-contenido :global(.piramide-nivel) {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    color: var(--color-blanco);
    text-align: center;
  }
  .modulo-contenido :global(.piramide-etiqueta) {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }
  .modulo-contenido :global(.piramide-desc) {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.85);
    margin: 0;
  }

  /* Contactos */
  .modulo-contenido :global(.modulo-contactos) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-4);
  }
  .modulo-contenido :global(.contacto-chip) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-5);
    background: var(--color-rosa-light);
    border: 2px solid var(--color-rosa);
    border-radius: var(--radius-md);
    text-decoration: none;
    min-height: 48px;
    justify-content: center;
    transition: background var(--transition-fast);
  }
  .modulo-contenido :global(.contacto-chip:hover) { background: var(--color-rosa); }
  .modulo-contenido :global(.contacto-chip-nombre) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-guinda);
  }
  .modulo-contenido :global(.contacto-chip-tel) {
    font-size: var(--text-xs);
    color: var(--color-texto-muted);
  }

  /* Quiz */
  .quiz-area {
    margin: 0 clamp(0.75rem, 4vw, var(--space-8)) clamp(0.75rem, 4vw, var(--space-8));
    background: var(--color-fondo-alt);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid var(--color-salvia-light);
  }

  .quiz-header {
    padding: clamp(1rem, 4vw, var(--space-6));
    background: var(--color-rosa-light);
    border-bottom: 2px solid var(--color-rosa);
  }

  .quiz-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-guinda);
    display: block;
    margin-bottom: var(--space-2);
  }

  .quiz-pregunta {
    font-family: var(--font-display);
    font-size: clamp(1rem, 4vw, var(--text-lg));
    font-weight: 700;
    color: var(--color-guinda);
    line-height: 1.4;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .quiz-opciones {
    padding: clamp(0.75rem, 3vw, var(--space-4)) clamp(0.75rem, 4vw, var(--space-6));
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .quiz-opcion {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-3) clamp(0.75rem, 3vw, var(--space-5));
    border: 2px solid var(--color-salvia-light);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.4;
    text-align: left;
    background: var(--color-blanco);
    color: var(--color-texto);
    transition: all var(--transition-fast);
    cursor: pointer;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .quiz-opcion:hover:not(:disabled) {
    border-color: var(--color-guinda);
    background: var(--color-fondo);
    transform: translateX(4px);
  }

  .quiz-opcion-letra {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-fondo-alt);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    flex-shrink: 0;
    margin-top: 2px;
  }

  :global(.opcion-correcta) {
    border-color: var(--semaforo-verde) !important;
    background: #D1FAE5 !important;
    color: var(--semaforo-verde) !important;
  }

  :global(.opcion-incorrecta) {
    border-color: var(--semaforo-rojo) !important;
    background: #FEE2E2 !important;
    color: var(--semaforo-rojo) !important;
  }

  .quiz-feedback {
    margin: 0 clamp(0.75rem, 4vw, var(--space-6)) clamp(0.75rem, 4vw, var(--space-6));
    padding: var(--space-4) clamp(0.75rem, 3vw, var(--space-5));
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    overflow-wrap: break-word;
    word-break: break-word;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .quiz-feedback[hidden] {
    display: none;
  }

  .quiz-reintentar-btn {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    border: 2px solid currentColor;
    background: transparent;
    color: inherit;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .quiz-reintentar-btn:hover {
    background: rgba(0,0,0,0.06);
  }

  :global(.quiz-feedback-ok) {
    background: #D1FAE5;
    color: var(--semaforo-verde);
    border: 1px solid #6EE7B7;
  }

  :global(.quiz-feedback-error) {
    background: #FEE2E2;
    color: var(--semaforo-rojo);
    border: 1px solid #FCA5A5;
  }

  /* Navegación módulo */
  .modulo-nav {
    display: flex;
    flex-direction: column-reverse;
    padding: clamp(1rem, 4vw, var(--space-6)) clamp(1rem, 5vw, var(--space-8));
    border-top: 1px solid var(--color-salvia-light);
    gap: var(--space-3);
  }

  .modulo-nav .btn {
    width: 100%;
    justify-content: center;
    min-height: 48px;
  }

  @media (min-width: 900px) {
    .modulo-nav {
      flex-direction: row;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .modulo-nav .btn {
      width: auto;
    }
  }

  .modulo-siguiente:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* Constancia */
  .constancia-hero {
    text-align: center;
    padding: clamp(2rem, 8vw, var(--space-16));
    background: var(--color-blanco);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-8);
  }

  .constancia-icon { font-size: clamp(3rem, 12vw, 5rem); margin-bottom: var(--space-4); }

  .constancia-hero h2 {
    font-size: clamp(1.5rem, 6vw, var(--text-3xl));
    font-weight: 900;
    color: var(--color-guinda);
    margin-bottom: var(--space-3);
    overflow-wrap: break-word;
  }

  .constancia-hero p {
    color: var(--color-texto-muted);
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
    overflow-wrap: break-word;
  }

  .constancia-calificacion {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-xl);
    color: var(--color-guinda);
  }

  .constancia-reintentar {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background: var(--color-fondo-alt);
    border: 2px solid var(--color-salvia-light);
    border-radius: var(--radius-lg);
  }

  .constancia-reintentar p {
    font-size: var(--text-base);
    color: var(--color-texto);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .constancia-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-8);
  }

  /* El atributo [hidden] no gana por especificidad frente a `display: flex`
     de arriba, así que hay que forzarlo explícitamente. */
  .constancia-actions[hidden] {
    display: none;
  }

  .constancia-actions .btn {
    width: 100%;
    justify-content: center;
    min-height: 48px;
  }

  @media (min-width: 480px) {
    .constancia-actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .constancia-actions .btn { width: auto; }
  }

  .constancia-nombre-form {
    background: var(--color-blanco);
    padding: clamp(1rem, 4vw, var(--space-6));
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .constancia-nombre-form .form-hint {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-texto-muted);
    margin-top: var(--space-2);
  }

  /* Wrapper de scroll horizontal para móvil */
  .constancia-preview-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: var(--space-8);
  }

  /* Constancia visual — orientación horizontal, proporción tipo diploma
     (similar a A4 landscape: ~1.41:1) */
  .constancia-preview {
    background: var(--color-blanco);
    background-image:
      linear-gradient(135deg, rgba(74,0,31,0.04) 0%, transparent 30%),
      linear-gradient(-45deg, rgba(106,15,73,0.04) 0%, transparent 30%);
