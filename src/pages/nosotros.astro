---
import BaseLayout from '../layouts/BaseLayout.astro';

// Portal oficial de legislación estatal.
const CELEM_URL = 'https://celem.segob.michoacan.gob.mx/celem/';
---

<BaseLayout
  title="Quiénes Somos"
  description="Conoce la Subsecretaría de Derechos Humanos y Población de Michoacán: misión, visión, marco normativo y estructura."
>

  <section class="nosotros-hero" aria-label="Quiénes somos">
    <div class="container">
      <span class="badge badge-rosa">Conoce la Subsecretaría</span>
      <h1 class="nosotros-title">Derechos Humanos para todas las personas</h1>
      <p class="nosotros-desc">
        Somos la instancia del Gobierno del Estado de Michoacán encargada de promover,
        defender y garantizar el pleno ejercicio de los derechos humanos de toda persona
        que habita o transita por nuestro estado.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Misión y visión">
    <div class="container">
      <div class="mv-grid">
        <div class="mv-card">
          <div class="mv-icon" aria-hidden="true">🎯</div>
          <h2>Misión</h2>
          <p>
            Promover, defender y garantizar los derechos humanos de toda persona
            que habita o transita en Michoacán, mediante acciones de prevención,
            atención, seguimiento y vinculación institucional, contribuyendo a la
            construcción de una cultura de paz y legalidad.
          </p>
        </div>
        <div class="mv-card">
          <div class="mv-icon" aria-hidden="true">🌟</div>
          <h2>Visión</h2>
          <p>
            Ser una instancia de referencia en la defensa y promoción de los derechos
            humanos, reconocida por la ciudadanía como un espacio de acceso a la justicia,
            transparente, accesible y comprometida con la transformación digital
            al servicio de las personas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-label="Marco normativo">
    <div class="container">
      <div class="text-center">
        <h2 class="section-title">Marco normativo</h2>
        <div class="divider divider-center"></div>
        <p class="section-subtitle">El trabajo de la Subsecretaría está fundamentado en las siguientes normas.</p>
      </div>

      <div class="normas-grid" style="margin-top:var(--space-12)">
        {[
          { nivel: 'Internacional', color: 'morado', normas: [
            'Declaración Universal de Derechos Humanos (1948)',
            'Pacto Internacional de Derechos Civiles y Políticos',
            'Pacto Internacional de Derechos Económicos, Sociales y Culturales',
            'Convención Americana sobre Derechos Humanos',
          ]},
          { nivel: 'Federal', color: 'guinda', normas: [
            'Constitución Política de los Estados Unidos Mexicanos (Art. 1°)',
            'Ley General de Víctimas',
            'Ley General de Transparencia y Acceso a la Información Pública',
            'Ley General de Protección de Datos Personales',
          ]},
          { nivel: 'Estatal', color: 'salvia', normas: [
            'Constitución Política del Estado de Michoacán',
            'Ley de Derechos Humanos del Estado de Michoacán',
            'Ley de Gobierno Digital del Estado de Michoacán',
            'Reglamento Interior de la Secretaría de Gobierno',
          ]},
        ].map(n => (
          <div class={`norma-card norma-${n.color}`}>
            <h3 class="norma-nivel">{n.nivel}</h3>
            <ul>
              {n.normas.map(ley => (
                <li>
                  {n.nivel === 'Estatal'
                    ? <a href={CELEM_URL} target="_blank" rel="noopener noreferrer">{ley} <span aria-hidden="true">↗</span></a>
                    : ley
                  }
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .nosotros-hero {
    background: linear-gradient(135deg, var(--color-guinda) 0%, var(--color-morado) 100%);
    padding-block: var(--space-16);
    text-align: center;
  }

  .nosotros-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 900;
    color: var(--color-blanco);
    margin-block: var(--space-4);
    max-width: 20ch;
    margin-inline: auto;
  }

  .nosotros-desc {
    color: rgba(255,255,255,0.80);
    max-width: 60ch;
    margin-inline: auto;
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .mv-grid {
    display: grid;
    gap: var(--space-8);
    max-width: 860px;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .mv-grid { grid-template-columns: 1fr 1fr; }
  }

  .mv-card {
    background: var(--color-blanco);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
    border-top: 4px solid var(--color-guinda);
  }

  .mv-icon { font-size: 2.5rem; margin-bottom: var(--space-4); }

  .mv-card h2 {
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-bottom: var(--space-4);
  }

  .mv-card p {
    color: var(--color-texto-muted);
    line-height: 1.8;
  }

  .normas-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .normas-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .norma-card {
    background: var(--color-blanco);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .norma-nivel {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid currentColor;
  }

  .norma-guinda .norma-nivel { color: var(--color-guinda); }
  .norma-morado .norma-nivel { color: var(--color-morado); }
  .norma-salvia .norma-nivel { color: var(--color-salvia); }

  .norma-card ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .norma-card li {
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
    line-height: 1.5;
    padding-left: var(--space-4);
    position: relative;
  }

  .norma-card li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-rosa-dark);
  }

  .norma-card li a {
    color: var(--color-guinda);
    font-weight: 600;
    text-decoration-color: var(--color-rosa-dark);
  }

  .norma-card li a:hover {
    color: var(--color-morado);
  }
</style>
