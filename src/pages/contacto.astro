---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto"
  description="Contáctate con la Subsecretaría de Derechos Humanos y Población de Michoacán. Atendemos dudas, denuncias y solicitudes de información."
>

  <section class="contacto-hero" aria-label="Contacto">
    <div class="container">
      <span class="badge badge-rosa">Estamos para escucharte</span>
      <h1 class="contacto-title">Contáctanos</h1>
      <p class="contacto-desc">
        Si tienes una duda, denuncia o solicitud de información, escríbenos.
        Nos comunicaremos contigo en un máximo de 24 horas hábiles.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Formulario de contacto">
    <div class="container contacto-layout">

      <!-- Formulario -->
      <div class="form-area">
        <h2 class="form-title">Envíanos un mensaje</h2>
        <form class="contacto-form" id="contacto-form" novalidate>
          <div class="form-group">
            <label for="nombre" class="form-label">Nombre completo <span aria-hidden="true">*</span></label>
            <input type="text" id="nombre" name="nombre" class="form-input" required placeholder="Tu nombre" autocomplete="name" />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Correo electrónico <span aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" class="form-input" required placeholder="tucorreo@ejemplo.com" autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="asunto" class="form-label">Asunto</label>
            <select id="asunto" name="asunto" class="form-select">
              <option value="">Selecciona el motivo de tu mensaje</option>
              <option value="duda-general">Duda general</option>
              <option value="seguimiento">Seguimiento a recomendación</option>
              <option value="denuncia">Denuncia o queja</option>
              <option value="solicitud-info">Solicitud de información</option>
              <option value="cursos">Información sobre cursos</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div class="form-group">
            <label for="mensaje" class="form-label">Mensaje <span aria-hidden="true">*</span></label>
            <textarea
              id="mensaje"
              name="mensaje"
              class="form-textarea"
              required
              placeholder="Describe tu consulta con el mayor detalle posible..."
              rows="5"
            ></textarea>
          </div>

          <div class="form-privacy">
            <input type="checkbox" id="privacidad" name="privacidad" required />
            <label for="privacidad">
              He leído y acepto el <a href="#">aviso de privacidad</a>. Entiendo que mis datos serán utilizados únicamente para atender mi solicitud.
            </label>
          </div>

          <button type="submit" class="btn btn-primary form-submit">
            Enviar mensaje
          </button>

          <div id="form-mensaje" hidden role="alert" class="form-success"></div>
        </form>
      </div>

      <!-- Información de contacto -->
      <aside class="contacto-info" aria-label="Información de contacto">
        <div class="info-card">
          <h3>Información de contacto</h3>

          <div class="info-item">
            <span class="info-emoji" aria-hidden="true">📍</span>
            <div>
              <strong>Dirección</strong>
              <p>Av. Acueducto s/n, Col. Ex-Hacienda de Guadalupe<br/>Morelia, Michoacán, México</p>
            </div>
          </div>

          <div class="info-item">
            <span class="info-emoji" aria-hidden="true">📞</span>
            <div>
              <strong>Teléfono</strong>
              <p><a href="tel:+524431234567">(443) 123-4567</a></p>
            </div>
          </div>

          <div class="info-item">
            <span class="info-emoji" aria-hidden="true">📧</span>
            <div>
              <strong>Correo institucional</strong>
              <p><a href="mailto:ddhh@michoacan.gob.mx">ddhh@michoacan.gob.mx</a></p>
            </div>
          </div>

          <div class="info-item">
            <span class="info-emoji" aria-hidden="true">🕐</span>
            <div>
              <strong>Horario de atención</strong>
              <p>Lunes a viernes<br/>9:00 am — 4:00 pm</p>
            </div>
          </div>
        </div>

        <div class="info-card info-urgente">
          <h3>¿Es una emergencia?</h3>
          <p>Si estás en una situación de riesgo inmediato o violación grave de derechos humanos, contacta directamente a:</p>
          <a href="tel:800-715-2000" class="btn btn-primary" style="margin-top:var(--space-4)">
            📞 CNDH: 800 715 2000
          </a>
          <a href="tel:443-000-0000" class="btn btn-secondary" style="margin-top:var(--space-3)">
            📞 CEDH Michoacán
          </a>
        </div>
      </aside>

    </div>
  </section>

</BaseLayout>

<script>
  document.getElementById('contacto-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const msgEl = document.getElementById('form-mensaje') as HTMLElement;

    // Validación simple
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Simular envío (en producción: fetch a un endpoint)
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Enviando...';

    setTimeout(() => {
      form.reset();
      btn.disabled = false;
      btn.textContent = 'Enviar mensaje';
      msgEl.removeAttribute('hidden');
      msgEl.textContent = '✅ Tu mensaje fue enviado correctamente. Te contactaremos en máximo 24 horas hábiles.';
      msgEl.scrollIntoView({ behavior: 'smooth' });
    }, 1200);
  });
</script>

<style>
  .contacto-hero {
    background: linear-gradient(135deg, var(--color-guinda) 0%, var(--color-morado) 100%);
    padding-block: var(--space-16);
    text-align: center;
  }

  .contacto-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 900;
    color: var(--color-blanco);
    margin-block: var(--space-4);
  }

  .contacto-desc {
    color: rgba(255,255,255,0.80);
    max-width: 52ch;
    margin-inline: auto;
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .contacto-layout {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 900px) {
    .contacto-layout { grid-template-columns: 1.4fr 1fr; }
  }

  .form-area {
    background: var(--color-blanco);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .form-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-bottom: var(--space-6);
  }

  .contacto-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-guinda);
  }

  .form-label span { color: var(--semaforo-rojo); }

  .form-input, .form-select, .form-textarea {
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-salvia-light);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-texto);
    background: var(--color-blanco);
    transition: border-color var(--transition-fast);
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-guinda);
  }

  .form-textarea { resize: vertical; min-height: 140px; }

  .form-privacy {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
    line-height: 1.6;
  }

  .form-privacy input { margin-top: 3px; flex-shrink: 0; }

  .form-submit {
    align-self: flex-start;
    font-size: var(--text-lg);
    padding: var(--space-4) var(--space-8);
  }

  .form-success {
    background: #D1FAE5;
    color: var(--semaforo-verde);
    border: 1px solid #6EE7B7;
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-display);
    font-weight: 600;
  }

  /* Info cards */
  .info-card {
    background: var(--color-blanco);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-4);
  }

  .info-card h3 {
    font-size: var(--text-lg);
    font-weight: 800;
    margin-bottom: var(--space-5);
    color: var(--color-guinda);
  }

  .info-item {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    align-items: flex-start;
  }

  .info-emoji { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }

  .info-item strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-guinda);
    margin-bottom: var(--space-1);
  }

  .info-item p {
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
    line-height: 1.6;
  }

  .info-item a {
    color: var(--color-guinda);
  }

  .info-urgente {
    border: 2px solid var(--color-guinda);
    background: var(--color-rosa-light);
  }

  .info-urgente h3 { color: var(--color-guinda-dark); }

  .info-urgente p {
    font-size: var(--text-sm);
    color: var(--color-texto-muted);
    line-height: 1.7;
  }

  .info-urgente .btn {
    display: flex;
    width: 100%;
    justify-content: center;
  }
</style>
