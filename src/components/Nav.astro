---
const navLinks = [
  { href: '/',           label: 'Inicio' },
  { href: '/semaforo',   label: 'Mis Recomendaciones' },
  { href: '/cursos',     label: 'Cursos DDHH' },
  { href: '/nosotros',   label: 'Quiénes Somos' },
  { href: '/contacto',   label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="nav-header" role="banner">
  <div class="container nav-inner">
    <!-- Logo + nombre -->
    <a href="/" class="nav-brand" aria-label="Ir al inicio — Subsecretaría de Derechos Humanos y Población">
      <div class="nav-logo-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" width="40" height="40">
          <!-- Escudo simplificado / placeholder identidad visual -->
          <circle cx="20" cy="20" r="19" fill="#4A001F" stroke="#FFC3D0" stroke-width="1.5"/>
          <path d="M20 8 C14 8 10 13 10 20 C10 27 14 32 20 34 C26 32 30 27 30 20 C30 13 26 8 20 8Z"
                fill="none" stroke="#FFC3D0" stroke-width="1.5"/>
          <circle cx="20" cy="18" r="4" fill="#FFC3D0"/>
          <path d="M14 28 Q20 24 26 28" stroke="#FFC3D0" stroke-width="1.5" fill="none" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="nav-brand-text">
        <span class="nav-brand-name">Subsecretaría</span>
        <span class="nav-brand-sub">Derechos Humanos y Población</span>
        <span class="nav-brand-estado">Gobierno de Michoacán</span>
      </div>
    </a>

    <!-- Nav desktop -->
    <nav class="nav-links" aria-label="Navegación principal">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { 'nav-link-active': isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a href="/semaforo" class="btn btn-primary nav-cta">
        Consultar mi caso
      </a>
    </nav>

    <!-- Botón menú móvil -->
    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <span class="hamburger" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Menú móvil -->
  <div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Menú de navegación" hidden>
    <nav aria-label="Navegación móvil">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['mobile-link', { 'mobile-link-active': isActive(link.href) }]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <div class="mobile-cta">
        <a href="/semaforo" class="btn btn-primary" style="width:100%;justify-content:center;">
          Consultar mi caso
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Abrir menú de navegación' : 'Cerrar menú de navegación');
    menu?.toggleAttribute('hidden');
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }
  });
</script>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-guinda);
    box-shadow: 0 2px 16px rgba(74,0,31,0.25);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  /* Marca / logo */
  .nav-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo-mark {
    flex-shrink: 0;
  }

  .nav-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .nav-brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-base);
    color: var(--color-blanco);
    letter-spacing: -0.01em;
  }

  .nav-brand-sub {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-rosa);
  }

  .nav-brand-estado {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.55);
    font-weight: 300;
  }

  /* Links desktop */
  .nav-links {
    display: none;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 1024px) {
    .nav-links { display: flex; }
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgba(255,255,255,0.80);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-blanco);
    background: rgba(255,255,255,0.10);
  }

  .nav-link-active {
    color: var(--color-rosa);
    background: rgba(255,195,208,0.12);
  }

  .nav-cta {
    margin-left: var(--space-2);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-5);
    background: var(--color-rosa);
    color: var(--color-guinda);
  }

  .nav-cta:hover {
    background: var(--color-blanco);
    color: var(--color-guinda-dark);
  }

  /* Toggle móvil */
  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.10);
    transition: background var(--transition-fast);
  }

  .nav-toggle:hover {
    background: rgba(255,255,255,0.18);
  }

  @media (min-width: 1024px) {
    .nav-toggle { display: none; }
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-blanco);
    border-radius: 2px;
    transition: all var(--transition-base);
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
  }

  .hamburger::before { top: -7px; }
  .hamburger::after  { top: 7px; }

  [aria-expanded="true"] .hamburger {
    background: transparent;
  }

  [aria-expanded="true"] .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }

  [aria-expanded="true"] .hamburger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* Menú móvil */
  .mobile-menu {
    background: var(--color-guinda-dark);
    padding: var(--space-4) var(--container-pad) var(--space-6);
    border-top: 1px solid rgba(255,195,208,0.15);
  }

  .mobile-menu[hidden] { display: none; }

  .mobile-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: rgba(255,255,255,0.80);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .mobile-link:hover {
    color: var(--color-blanco);
    background: rgba(255,255,255,0.08);
  }

  .mobile-link-active {
    color: var(--color-rosa);
  }

  .mobile-cta {
    margin-top: var(--space-6);
  }
</style>
